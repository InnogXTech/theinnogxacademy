# Copy this file to `.env.local` (or set environment variables in your hosting provider).
# DO NOT commit your real secret keys to Git.

# Frontend (public key) - safe to expose to client-side, but keep it out of source control.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxx
# Set to `test` or `live` depending on environment.
VITE_PAYSTACK_ENV=live

# Backend (secret key) - MUST be kept secret and set in your deployment environment.
PAYSTACK_SECRET_KEY=sk_live_xxxxx
